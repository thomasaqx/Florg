# Copie para .env e ajuste. O .env NUNCA vai para o git (ver backend/.gitignore).

# Use "db" como host ao rodar via Docker Compose.
DATABASE_URL=postgresql+psycopg://florg:florg@db:5432/florg
# Rodando a API direto na maquina, use localhost:
# DATABASE_URL=postgresql+psycopg://florg:florg@localhost:5432/florg

# Gere uma chave real com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em producao a API se recusa a subir com chave de exemplo ou menor que 32 bytes.
SECRET_KEY=troque-esta-chave-em-producao

ACCESS_TOKEN_EXPIRE_MINUTES=60

# "dev" libera CORS para qualquer origem (sem credenciais).
# "prod" aceita apenas as origens listadas abaixo.
ENVIRONMENT=dev
CORS_ORIGINS=https://app.florg.com.br

# --- FLORA AI -----------------------------------------------------------
# "auto"   usa o Claude se ANTHROPIC_API_KEY estiver definida e o provider
#          offline caso contrario. E o padrao: sem chave, o chat funciona.
# "mock"   forca o provider offline mesmo com chave configurada.
# "claude" exige a chave; sem ela a API se recusa a subir.
AI_PROVIDER=auto

# A chave fica SO no backend. O Flutter chama POST /ai/chat e nunca
# api.anthropic.com. Nao commite este arquivo (.env esta no .gitignore).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
