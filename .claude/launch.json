{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "florg-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8080",
        "--web-hostname",
        "127.0.0.1",
        "--dart-define=FLORG_API_BASE_URL=http://127.0.0.1:8000"
      ],
      "port": 8080
    }
  ]
}
